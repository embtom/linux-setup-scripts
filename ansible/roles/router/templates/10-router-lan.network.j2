[Match]
Name={{ router_lan_interface }}

[Network]
Address={{ router_lan_address }}
DHCPServer=yes
IPv6AcceptRA=no
# Enable .local service discovery on this LAN link. The resolved drop-in also
# enables mDNS globally; both the global and per-link settings are required.
MulticastDNS=yes
# Avoid legacy LLMNR name resolution and responder behavior on the LAN.
LLMNR=no

[DHCPServer]
PoolOffset={{ router_dhcp_pool_offset }}
PoolSize={{ router_dhcp_pool_size }}
EmitDNS=yes
DNS={{ router_dhcp_dns_servers | join(' ') }}
EmitRouter=yes
Router={{ router_dhcp_gateway }}
DefaultLeaseTimeSec={{ router_dhcp_default_lease_time }}
MaxLeaseTimeSec={{ router_dhcp_max_lease_time }}
